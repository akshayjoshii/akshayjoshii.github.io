# Comma-separated browser origins allowed to submit analytics events.
ALLOWED_ORIGINS=https://akjo.tech,https://www.akjo.tech

# Event data is deliberately limited to anonymous Instagram-originated events.
RETENTION_DAYS=30
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
MAX_REQUEST_BYTES=8192

# The dashboard is disabled until this is set on the Oracle VM.
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=
